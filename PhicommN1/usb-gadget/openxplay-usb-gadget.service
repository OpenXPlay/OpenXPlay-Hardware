[Unit]
Description=OpenXPlay USB management gadget (NCM Ethernet and serial console on the OTG port)
After=systemd-modules-load.service
Wants=openxplay-usb-dhcp.service serial-getty@ttyGS0.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/libexec/openxplay-usb-gadget start
ExecStop=/usr/local/libexec/openxplay-usb-gadget stop

[Install]
WantedBy=multi-user.target
