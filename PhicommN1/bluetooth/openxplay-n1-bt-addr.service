[Unit]
Description=Give the Phicomm N1 Bluetooth controller a per-device address
Before=bluetooth.service
Before=openxplay-relay.service

[Service]
Type=oneshot
ExecStart=/usr/lib/openxplay-phicomm-n1/bt-addr
TimeoutStartSec=90

[Install]
WantedBy=bluetooth.target
