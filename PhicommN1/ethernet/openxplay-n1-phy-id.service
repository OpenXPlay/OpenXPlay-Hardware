[Unit]
Description=Identify the Phicomm N1 Ethernet PHY in the boot device tree
RequiresMountsFor=/boot

[Service]
Type=oneshot
ExecStart=/usr/lib/openxplay-phicomm-n1/phy-id apply

[Install]
WantedBy=multi-user.target
