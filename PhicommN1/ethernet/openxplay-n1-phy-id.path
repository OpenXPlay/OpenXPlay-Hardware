[Unit]
Description=Watch Phicomm N1 boot device tree updates
RequiresMountsFor=/boot

[Path]
PathChanged=/boot/uEnv.txt
PathChanged=/boot/dtb/amlogic/meson-gxl-s905d-phicomm-n1.dtb
PathChanged=/boot/dtb/amlogic/meson-gxl-s905d-phicomm-n1-thresh.dtb
Unit=openxplay-n1-phy-id.service

[Install]
WantedBy=multi-user.target
