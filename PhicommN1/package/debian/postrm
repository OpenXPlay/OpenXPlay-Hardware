set -eu
fail() { echo "openxplay-phicomm-n1: $*" >&2; exit 1; }
# Runtime actions only on a booted system, never in an image build or chroot.
live() { [ -d /run/systemd/system ]; }
case "$1" in
remove|purge)
    if live; then systemctl --system daemon-reload >/dev/null || :; fi
    ;;
esac
for unit in openxplay-n1-phy-id.service openxplay-n1-phy-id.path openxplay-n1-bt-addr.service; do
    if [ "$1" = remove ] && [ -x /usr/bin/deb-systemd-helper ]; then
        deb-systemd-helper mask "$unit" >/dev/null || :
    fi
    if [ "$1" = purge ] && [ -x /usr/bin/deb-systemd-helper ]; then
        deb-systemd-helper purge "$unit" >/dev/null || :
        deb-systemd-helper unmask "$unit" >/dev/null || :
    fi
done
if [ "$1" = purge ]; then
    rm -rf /var/lib/openxplay-phicomm-n1 || fail 'cannot remove device state'
fi
exit 0
