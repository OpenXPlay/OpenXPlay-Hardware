# Created by riko chen on 2026-10-21
set -eu
case "$1" in
remove|purge)
    if [ -d /run/systemd/system ]; then systemctl --system daemon-reload >/dev/null || :; fi
    ;;
esac
if [ "$1" = purge ]; then
    deb-systemd-helper purge openxplay-usb-gadget.service >/dev/null || :
    deb-systemd-helper unmask openxplay-usb-gadget.service >/dev/null || :
    rm -f /run/openxplay-usb-dhcp.leases /run/openxplay-usb-dhcp.pid
fi
exit 0
