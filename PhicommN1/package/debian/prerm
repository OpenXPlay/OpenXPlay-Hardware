# Created by riko chen on 2026-10-21
set -eu
case "$1" in
remove|deconfigure)
    if [ -d /run/systemd/system ]; then
        deb-systemd-invoke stop openxplay-usb-gadget.service >/dev/null || :
    fi
    deb-systemd-helper disable openxplay-usb-gadget.service >/dev/null || :
    ;;
esac
exit 0
