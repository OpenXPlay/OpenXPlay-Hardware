[Unit]
Description=OpenXPlay Bluetooth controller guard
After=bluetooth.service

[Service]
Type=simple
ExecStart=/usr/local/libexec/openxplay-bt-guard
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
